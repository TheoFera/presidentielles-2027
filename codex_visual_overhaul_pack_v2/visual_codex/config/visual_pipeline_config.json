{
  "version": 1,
  "reference_images": {
    "style_target": "visual_codex/references/STYLE_TARGET.png",
    "greybox": [
      "visual_codex/references/GREYBOX_01.png",
      "visual_codex/references/GREYBOX_02.png"
    ]
  },
  "canonical_viewport": {
    "width": 1920,
    "height": 1080
