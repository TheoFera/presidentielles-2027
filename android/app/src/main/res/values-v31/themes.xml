<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Presidentielles" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/game_background</item>
        <item name="android:colorBackground">@color/game_background</item>
        <item name="android:statusBarColor">@color/game_background</item>
        <item name="android:navigationBarColor">@color/game_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!-- Écran de démarrage d'Android 12 et plus. -->
        <item name="android:windowSplashScreenBackground">@color/game_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
