<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Multijoueur entre téléphones (WebRTC sur le Wi-Fi local). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Scan des QR codes d'invitation, seulement si le joueur l'accepte. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Pas d'android:isGame ni d'appCategory="game" : depuis Android 15, le système limite par défaut
         les applis déclarées comme jeux à 60 images par seconde (game_default_frame_rate_override).
         Mesuré le 05/10/2026 sur un Redmi Note 13 Pro 5G : jeu saccadé dans l'appli, fluide dans Chrome.
         La catégorie « Jeu » du Play Store se règle dans la Play Console. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_v2"
        android:roundIcon="@mipmap/ic_launcher_round_v2"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:supportsRtl="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Presidentielles">

        <!-- Identifiant de l'application AdMob (android/gradle.properties). Obligatoire dès que le SDK des pubs est présent. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Démarrage plus rapide : le SDK des pubs s'initialise hors du fil principal. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
